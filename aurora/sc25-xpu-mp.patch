+def dp_mean_(tensor):
+    """In-place mean over the data-parallel group (SUM / size: ReduceOp.AVG
+    isn't supported by every backend, e.g. xccl)."""
+    torch.distributed.all_reduce(tensor, group=comm.get_group("dp"))
+    tensor.div_(comm.get_size("dp"))
+    return tensor
+
+
+def _allreduce_coalesced_(grads, group, divisor=1):
+    flat = _flatten_dense_tensors(grads)
+    torch.distributed.all_reduce(flat, group=comm.get_group(group))
+    if divisor > 1:
+        flat.div_(divisor)
+    for buf, synced in zip(grads, _unflatten_dense_tensors(flat, grads)):
+        buf.copy_(synced)
+
+
+def sync_grads_after_backward(model):
+    """Gradient sync done after backward instead of by DDP hooks during it,
+    so dp collectives never overlap the tp/cp ones issued inside backward
+    (that overlap can deadlock oneCCL on XPU). Same reductions as the DDP
+    path in distributed/mappings.py: mean over dp, plus a sum over the
+    groups in p.mark_for_reduction when cp > 1."""
+    params = [p for p in model.parameters() if p.grad is not None]
+    if not params:
+        return
+    if comm.get_size("dp") > 1:
+        _allreduce_coalesced_([p.grad for p in params], "dp", comm.get_size("dp"))
+    if comm.get_size("cp") > 1:
+        for group in comm.get_names():
+            if group == "dp":
+                continue
+            grads = [
+                p.grad for p in params if group in getattr(p, "mark_for_reduction", [])
+            ]
+            if grads:
+                _allreduce_coalesced_(grads, group)
+
+
