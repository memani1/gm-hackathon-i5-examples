+def memory_used_gb() -> float:
+    """Device memory in use (GB), all processes; replaces pynvml on cuda."""
+    accel = {"cuda": torch.cuda, "xpu": getattr(torch, "xpu", None)}.get(DEVICE_TYPE)
+    if accel is None:
+        return 0.0
+    try:
+        free, total = accel.mem_get_info()
+        used = total - free
+    except (AttributeError, RuntimeError):
+        # older torch.xpu has no mem_get_info; fall back to this process only
+        used = accel.memory_reserved()
+    return used / 1024.0**3
+
+
 def dist_backend() -> str:
     default = {"cuda": "nccl", "xpu": "xccl"}.get(DEVICE_TYPE, "gloo")
     backend = os.environ.get("TORCH_DISTRIBUTED_BACKEND", default)
